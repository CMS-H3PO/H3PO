        {"key": "MP",  "value": {"nodetype": "binning", "input": "pt", "edges": [400.0, 500.0, 100000.0], "content": [1.03, 1.10], "flow": "clamp"}},
        {"key": "HP",  "value": {"nodetype": "binning", "input": "pt", "edges": [400.0, 500.0, 100000.0], "content": [0.98, 1.05], "flow": "clamp"}},
