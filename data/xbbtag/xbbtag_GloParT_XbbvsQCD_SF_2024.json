        {"key": "HP",  "value": {"nodetype": "binning", "input": "pt", "edges": [400.0, 500.0, 100000.0], "content": [0.90, 0.97], "flow": "clamp"}},
        {"key": "VHP", "value": {"nodetype": "binning", "input": "pt", "edges": [400.0, 500.0, 100000.0], "content": [0.90, 0.99], "flow": "clamp"}}
