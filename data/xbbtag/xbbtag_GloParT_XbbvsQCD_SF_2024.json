{
 "schema_version": 2,
 "description": "LOCAL GloParT X->bb vs QCD scale factors for 2024 (NOT an official CMS POG payload). Built from the BTV Z(bb) GloParT results for 2024 (R. Gerosa, 'Results in 2024 for pT in [400,500] GeV' and 'pT > 500 GeV', single WPs VLP/LP/MP/HP/VHP). Only the Z(bb) table is used (no Z(gamma), no mu-tag). Binning: pT [400,500) and [500,inf). Flow 'clamp': pT < 400 GeV uses the [400,500) value (extrapolation). Systematics: 'up' = central + err_up, 'down' = central - err_down (asymmetric errors from the table). Working point 'L' is an alias of 'LP' (analysis default). Replace with the official payload once available.",
 "corrections": [
  {
   "name": "GloParT_XbbvsQCD_wp_values",
   "description": "GloParT X->bb vs QCD score thresholds of the single WPs (VLP>0.80, LP>0.85, MP>0.90, HP>0.95, VHP>0.98). 'L' is an alias of 'LP'.",
   "version": 2,
   "inputs": [
    {
     "name": "working_point",
     "type": "string",
     "description": "VLP/L/LP/MP/HP/VHP"
    }
   ],
   "output": {
    "name": "wp",
    "type": "real"
   },
   "data": {
    "nodetype": "category",
    "input": "working_point",
    "content": [
     {"key": "VLP", "value": 0.80},
     {"key": "L",   "value": 0.85},
     {"key": "LP",  "value": 0.85},
     {"key": "MP",  "value": 0.90},
     {"key": "HP",  "value": 0.95},
     {"key": "VHP", "value": 0.98}
    ]
   }
  },
  {
   "name": "GloParT_XbbvsQCD_comb",
