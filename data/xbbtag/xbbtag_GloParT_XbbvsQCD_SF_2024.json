       "content": [
        {"key": "VLP", "value": {"nodetype": "binning", "input": "pt", "edges": [400.0, 500.0, 100000.0], "content": [0.91, 1.07], "flow": "clamp"}},
        {"key": "L",   "value": {"nodetype": "binning", "input": "pt", "edges": [400.0, 500.0, 100000.0], "content": [0.93, 1.04], "flow": "clamp"}},
